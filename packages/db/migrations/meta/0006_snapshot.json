  "views": {
    "public.v_latest_price": {
      "columns": {
        "ingredient_id": {
          "name": "ingredient_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "supplier_id": {
          "name": "supplier_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "unit_price": {
          "name": "unit_price",
          "type": "bigint",
          "primaryKey": false,
          "notNull": true
        },
        "recorded_at": {
          "name": "recorded_at",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": true
        },
        "prev_unit_price": {
          "name": "prev_unit_price",
          "type": "bigint",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n  select ingredient_id, supplier_id, unit_price, recorded_at, prev_unit_price\n  from (\n    select ingredient_id, supplier_id, unit_price, recorded_at,\n      lag(unit_price) over w as prev_unit_price,\n      row_number() over (partition by ingredient_id order by recorded_at desc, created_at desc) as rn\n    from ingredient_prices\n    window w as (partition by ingredient_id order by recorded_at, created_at)\n  ) ranked\n  where rn = 1\n",
      "name": "v_latest_price",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
    "public.v_latest_price_by_supplier": {
      "columns": {
        "ingredient_id": {
          "name": "ingredient_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "supplier_id": {
          "name": "supplier_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "unit_price": {
          "name": "unit_price",
          "type": "bigint",
          "primaryKey": false,
          "notNull": true
        },
        "recorded_at": {
          "name": "recorded_at",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  select distinct on (ingredient_id, supplier_id) ingredient_id, supplier_id, unit_price, recorded_at\n  from ingredient_prices\n  order by ingredient_id, supplier_id, recorded_at desc, created_at desc\n",
      "name": "v_latest_price_by_supplier",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
