# --- Core ---
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
DATABASE_URL=postgres://botop:botop@localhost:5432/botop
SESSION_SECRET=change-me
API_PORT=3000
COOKIE_SECURE=false
UPLOAD_DIR=/data/uploads
PUBLIC_WEB_URL=https://op.example.com

# --- Seed owner ---
SEED_OWNER_NAME=Marcus
SEED_OWNER_PHONE=09xxxxxxxx
SEED_OWNER_PIN=123456

# --- Web Push (npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- AI ---
ANTHROPIC_API_KEY=
AI_MODEL_CLASSIFY=claude-haiku-4-5-20251001
AI_MODEL_REPORT=claude-sonnet-5-5

# --- Zalo agent ---
ZALO_SESSION_DIR=/data/zalo-session
AGENT_SEND_ENABLED=false
AGENT_SEND_MIN_INTERVAL_MS=3000

# --- Reports (cron, Asia/Ho_Chi_Minh) ---
REPORT_MIDDAY_CRON=0 14 * * *
REPORT_DAILY_CRON=0 22 * * *
REPORT_WEEKLY_CRON=0 22 * * 0
